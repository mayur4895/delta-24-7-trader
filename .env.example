# Delta Exchange 24/7 Cloud Trader - Environment Variables
# Copy these values into your Render.com / Railway environment settings

# Delta Exchange India API Credentials
DELTA_API_KEY=your_delta_api_key_here
DELTA_API_SECRET=your_delta_api_secret_here
DELTA_ENV=live_india

# Trading Symbol (Default: XRPUSD - 1 contract = 1 XRP, requires only ~$0.097 margin)
SCAN_SYMBOL=XRPUSD

# Scan frequency in seconds (Default: 60s)
SCAN_INTERVAL_SECONDS=60

# Port (Automatically set by Render/Railway, defaults to 5050 locally)
PORT=5050
